--!strict
-- Briefs: what each sound cue (Definitions/Sounds) should sound like, so Shortlist can search Roblox's audio library
-- for it and rank what it finds by shape (Waveform) before the owner listens. Studio tool data, not shipped. The shapes
-- follow the reference's measured qualities (docs/reference/network-test/audio.md): weight first, blade sounds crisp
-- and short, big skills low with long tails, the bite a low thump. Inspiration only, never a copy.
--   Brief: the sound in words.
--   Keywords: library searches; wide on purpose (unrelated sounds often hold the perfect slice).
--   Avoid: title words that rule a sound out for this cue (Shortlist adds the global gore, IP and junk words).
--   Prefer: title words that make a sound likelier to fit.
--   Mode: Hit (one burst), Sequence (several bursts, e.g. a reload's clicks), Rise (swells to a late peak), Fall
--         (starts loud and fades), Loop (a steady stretch that repeats).
--   Slice: how long the cue's slice may last (seconds). Attack: start to peak. Tail: peak to 40 dB down.
--   Bands: the rough energy balance it should have (low: body, thump; high: air, metal, hiss).
--   Events: for a Sequence, how many bursts it should hold. MaxFile: the longest file worth searching (seconds).

export type Brief = {
	Brief: string,
	Keywords: { string },
	Avoid: { string }?,
	Prefer: { string }?,
	Mode: "Hit" | "Sequence" | "Rise" | "Fall" | "Loop",
	Slice: { number },
	Attack: { number },
	Tail: { number },
	Bands: { Low: number, Mid: number, High: number },
	Events: { number }?,
	MaxFile: number?,
}

